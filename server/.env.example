# Copy this file to .env and fill in values. Never commit .env.

# Use Render's Internal Database URL when the API runs on Render.
# Use the External Database URL for local development.
DATABASE_URL=postgresql://user:password@host:5432/iphone_trend

# Set to "require" when connecting via Render's External Database URL.
# Leave unset for Render's Internal Database URL.
# PGSSLMODE=require

# Restrict CORS to your deployed frontend origin.
# FRONTEND_ORIGIN=https://your-app.onrender.com

# Optional: API port (default 8787)
# PORT=8787

# Optional: maximum PostgreSQL pool connections (default 5)
# PG_POOL_MAX=5
